# Local development only. Copy to .env and replace every placeholder.
# Generate secrets with: openssl rand -hex 24   /   openssl rand -base64 32
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=Applying
POSTGRES_PORT=5433
DATABASE_URL=postgresql://datapilot:Applying@localhost:5433/datapilot?schema=public

# DATABASE_URL=postgresql://neondb_owner:npg_rpXK5AQGYqj3@ep-gentle-leaf-b5ee6uvg-pooler.c-7.us-east-2.aws.neon.tech/datapilot_db?sslmode=require&channel_binding=require

API_PORT=4000
WEB_ORIGIN=http://localhost:3100
# Public URL used in email links and payment callbacks (defaults to WEB_ORIGIN).
# PUBLIC_WEB_URL=https://app.example.com
NODE_ENV=development

# Private file storage. Files are AES-256-GCM encrypted with this key.
# Losing the key makes stored datasets unreadable; rotating it needs a re-encryption job.
STORAGE_DIR=./storage
STORAGE_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Python processing worker (paths are relative to the repository root).
WORKER_PYTHON=.venv/bin/python
WORKER_CONCURRENCY=2
WORKER_TIMEOUT_SECONDS=180

# Email (verification, password reset, invitations).
# Test your settings with:  npm run mail:test -- you@example.com
#
# Local development: Mailpit from compose.yaml catches all mail (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=DataPilot <no-reply@datapilot.local>
#
# Real delivery to users' inboxes: replace the block above with your provider's details.
#
#   Gmail (quick start, ~500 emails/day; needs 2-Step Verification + an App Password
#   from https://myaccount.google.com/apppasswords; MAIL_FROM must be the same Gmail address):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=465
#     SMTP_SECURE=true
#     SMTP_USER=you@gmail.com
#     SMTP_PASS=your-16-character-app-password
#     MAIL_FROM=DataPilot <you@gmail.com>
#
#   Brevo / Resend / SendGrid / Mailgun / Amazon SES (recommended for production; verify
#   your own domain with SPF/DKIM so mail is not marked as spam):
#     SMTP_HOST=smtp-relay.brevo.com   (or smtp.resend.com, smtp.sendgrid.net, ...)
#     SMTP_PORT=587
#     SMTP_USER=...                    (from the provider dashboard)
#     SMTP_PASS=...
#     MAIL_FROM=DataPilot <no-reply@yourdomain.com>
#
# Without any SMTP settings (development only) links are returned in API responses instead.

# Paystack (test keys start with sk_test_). Leave empty to disable online checkout;
# super-admins can still activate subscriptions manually.
PAYSTACK_SECRET_KEY=
BILLING_GRACE_DAYS=3
# Free trial every new account gets when its email is verified (one per person
# and per organisation). Set to 0 to require a subscription from day one.
TRIAL_DAYS=14
