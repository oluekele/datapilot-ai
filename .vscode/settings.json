{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.analysis.exclude": [
    "**/.venv",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
